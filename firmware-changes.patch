+// ------------------------------------------------------------
+//  自定义布局的运行时切换（水平 <-> 侧躺 90°）
+// ------------------------------------------------------------
+
+void AP_Motors6DOF::set_motor_factors(int8_t motor_num, float roll_fac, float pitch_fac,
+                                      float yaw_fac, float climb_fac,
+                                      float forward_fac, float lat_fac)
+{
+    if (motor_num < 0 || motor_num >= AP_MOTORS_MAX_NUM_MOTORS) {
+        return;
+    }
+    _roll_factor[motor_num]     = roll_fac;
+    _pitch_factor[motor_num]    = pitch_fac;
+    _yaw_factor[motor_num]      = yaw_fac;
+    _throttle_factor[motor_num] = climb_fac;
+    _forward_factor[motor_num]  = forward_fac;
+    _lateral_factor[motor_num]  = lat_fac;
+}
+
+void AP_Motors6DOF::apply_custom_frame(bool rolled_90)
+{
+    if (rolled_90) {
+        // ---- 侧躺 90° 工作姿态 ----
+        // M1~M4 推水平侧向 -> Roll + Yaw
+        // M5/M6 推前后     -> Pitch + Forward
+        // M7   推垂直     -> Climb（深度）
+        set_motor_factors(AP_MOTORS_MOT_1, -1.000f,  0,      -0.273f, 0,      0,      0);
+        set_motor_factors(AP_MOTORS_MOT_2,  1.000f,  0,      -0.273f, 0,      0,      0);
+        set_motor_factors(AP_MOTORS_MOT_3, -1.000f,  0,       0.273f, 0,      0,      0);
+        set_motor_factors(AP_MOTORS_MOT_4,  1.000f,  0,       0.273f, 0,      0,      0);
+        set_motor_factors(AP_MOTORS_MOT_5,  0,      -0.702f,  0,      0,      1.000f, 0);
+        set_motor_factors(AP_MOTORS_MOT_6,  0,       0.702f,  0,      0,      1.000f, 0);
+        set_motor_factors(AP_MOTORS_MOT_7,  0,       0,       0,      1.000f, 0,      0);
+
+    } else {
+        // ---- 常规水平姿态 ----
+        // M1~M4 推垂直 -> Roll + Pitch + Climb
+        // M5/M6 推前后 -> Yaw + Forward
+        // M7   推横移 -> Lateral
+        set_motor_factors(AP_MOTORS_MOT_1, -1.000f, -1.000f,  0,      1.000f, 0,      0);
+        set_motor_factors(AP_MOTORS_MOT_2,  1.000f, -1.000f,  0,      1.000f, 0,      0);
+        set_motor_factors(AP_MOTORS_MOT_3, -1.000f,  1.000f,  0,      1.000f, 0,      0);
+        set_motor_factors(AP_MOTORS_MOT_4,  1.000f,  1.000f,  0,      1.000f, 0,      0);
+        set_motor_factors(AP_MOTORS_MOT_5,  0,       0,       0.702f, 0,      1.000f, 0);
+        set_motor_factors(AP_MOTORS_MOT_6,  0,       0,      -0.702f, 0,      1.000f, 0);
+        set_motor_factors(AP_MOTORS_MOT_7,  0,       0,       0,      0,      0,      1.000f);
+    }
+}
+
+void AP_Motors6DOF::configure_custom_frame(bool rolled_90)
+{
+    if (rolled_90 == _rolled_90) {
+        return;
+    }
+    _rolled_90 = rolled_90;
+    apply_custom_frame(rolled_90);
+}
